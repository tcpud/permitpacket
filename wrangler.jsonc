{
  "name": "permitpacket",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "vars": {
    // Written to the Application Version column. Update when Form TC2.1 changes.
    "APP_VERSION": "NOT EARLY TC 2.1"
  },
  // At most 5 requests per minute from one visitor, to one email address,
  // or for one property. Stops someone from flooding inboxes.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
  // FLOW_URL is a secret, set in the Cloudflare dashboard
}
