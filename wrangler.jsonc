{
  "name": "permitpacket",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "vars": {
    // Written to the Application Version column. Update when Form TC2.1 changes.
    "APP_VERSION": "NOT EARLY TC 2.1"
  },
  "observability": { "enabled": true }
  // FLOW_URL is a secret: npx wrangler secret put FLOW_URL
}
